# copia este ficheiro para .env e preenche. o .env não vai para o git.
# estas variáveis ficam no bundle final: são configuração pública do Firebase (a segurança está nas firestore.rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# só para a consola do Vini: o uid da conta da Leonor (Firebase, Authentication, coluna "UID do utilizador")
VITE_UID_LEONOR=
