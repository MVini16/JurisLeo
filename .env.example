# copia este ficheiro para .env e preenche os valores
# (firebase console > definições do projeto > as tuas apps > config)
# ou: firebase apps:sdkconfig WEB <app-id> --project jurisleo-67124
# sem estas variáveis o build sai sem apiKey e a app fica em branco
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
