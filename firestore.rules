rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // cada utilizador só pode ler e escrever os seus próprios dados —
    // esta é a única utilizadora da app, mas a regra fica correcta na mesma
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
