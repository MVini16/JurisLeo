rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // a conta do vini (consola /admin): só pode LER os dados da leonor, nunca escrever.
    // decidido com o vini a 07-10-2026, e a leonor é avisada nas definições ("o vini consegue ver...")
    function eOVini() {
      return request.auth != null && request.auth.uid == 'jgV92T5YCgclq0uVjyAUENuWwQ43';
    }

    // cada utilizador só pode ler e escrever os seus próprios dados —
    // esta é a única utilizadora da app, mas a regra fica correcta na mesma
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || eOVini();
      allow write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read: if (request.auth != null && request.auth.uid == uid) || eOVini();
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
